{
  "manifest_version": 3,
  "name": "Fener Mail Takip",
  "version": "1.1.0",
  "description": "Gmail'den gönderilen her maile otomatik açılma ve tıklama takibi ekler. Veriler Mail Takip Google Sheet'ine düşer.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.workers.dev/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["config.js", "sha256.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fener Mail Takip",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
